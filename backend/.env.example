HOST=127.0.0.1
PORT=8080
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=SpAgent
DB_USER=spagent_local
DB_PASSWORD=

CORS_ORIGIN=http://localhost:5173

# Set a strong random key (>= 32 chars in production, e.g. openssl rand -hex 32).
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Public server hardening: close open registration or require an invite code to protect AI API quota.
ALLOW_PUBLIC_REGISTRATION=true
REGISTRATION_INVITE_CODE=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=120
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=100
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=300
CRAWLER_REFRESH_RATE_LIMIT_WINDOW_MS=900000
CRAWLER_REFRESH_RATE_LIMIT_MAX=30
LOGIN_FAILURE_WINDOW_MS=600000
LOGIN_FAILURE_MAX=5
LOGIN_BLOCK_MINUTES=10

STATS_CACHE_TTL_SECONDS=60

AMAP_JS_API_KEY=
AMAP_SECURITY_CODE=
# Optional production reverse-proxy path for AMap JS API 2.0 (hides raw AMAP_SECURITY_CODE from browser)
AMAP_SERVICE_HOST=

# Automatic domestic half/full marathon race calendar crawler (chinamarathon.com)
EVENT_CRAWLER_ENABLED=true

AI_PROVIDER=deepseek
AI_DEEPSEEK_MODEL=deepseek-chat
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Leave blank for the local rules fallback.
DEEPSEEK_API_KEY=
# Optional: enable online coaching with scoped tool results and plan intent parsing.
AGENT_USE_DEEPSEEK=false
# Enable live weather/AQI (Open-Meteo, zero-key) and web search in AI Coach.
AGENT_WEB_SEARCH_ENABLED=true
# Optional: Tavily API key for premium web search; falls back to zero-key public search when blank.
TAVILY_API_KEY=
AI_TIMEOUT_MS=60000
AI_FALLBACK_RULES=true

GARMIN_PYTHON_PATH=python
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_NON_INTERACTIVE=0
GARMIN_DOWNLOAD_SCRIPT=../database/scripts/download_garmin_connect.py
GARMIN_IMPORT_SCRIPT=../database/scripts/import_fit_files.py
GARMIN_HEALTH_IMPORT_SCRIPT=../database/scripts/import_garmin_health.py
GARMIN_TOKEN_BASE_DIR=../database/.garmin_tokens/users
GARMIN_SYNC_WORK_DIR=../database/data/garmin_sync
GARMIN_JSON_MODE=summary
GARMIN_CHUNK_DAYS=14
GARMIN_CHUNK_SLEEP_SECONDS=10
GARMIN_SLEEP_SECONDS=1.5
GARMIN_EXTRA_SLEEP_SECONDS=0.5
GARMIN_RETRIES=2
GARMIN_SYNC_TIMEOUT_MS=900000
